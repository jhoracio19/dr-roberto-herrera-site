{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web-otorrino/browser",
  "routes": [
    { "src": "^/(.*)/$", "headers": { "Location": "/$1" }, "status": 308 },
    {
      "src": "^(?:/(.*))?$",
      "headers": { "Location": "https://otorrinotlaxcala.com/$1" },
      "status": 308,
      "has": [{ "type": "host", "value": "www.otorrinotlaxcala.com" }]
    },
    { "src": "^/cirugias\\.php$", "headers": { "Location": "/cirugias" }, "status": 308 },
    { "src": "^/src/img/cv\\.pdf$", "headers": { "Location": "/" }, "status": 308 },
    { "src": "^/index\\.php$", "headers": { "Location": "/" }, "status": 308 },
    { "src": "^/enfermedades\\.php$", "headers": { "Location": "/enfermedades" }, "status": 308 },
    { "src": "^/estetico\\.php$", "headers": { "Location": "/esteticos" }, "status": 308 },
    { "src": "^/pacientes\\.php$", "headers": { "Location": "/" }, "status": 308 },
    { "handle": "filesystem" },
    { "src": "^/api(/.*)?$", "status": 404 },
    { "src": "^/(.*)$", "status": 404, "dest": "/404.html" }
  ]
}
